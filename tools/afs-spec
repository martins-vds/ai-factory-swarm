#!/usr/bin/env python3
"""afs-spec — run the customer spec: a slice's behaviour written as data (ADR-0061, test-trust plan phase 1).

Usage:
  afs-spec check  [--spec .migration/spec] [--ledger .migration/ledger] [--require]
  afs-spec run    [--spec .migration/spec] [--slice S] [--adapter django] [--results FILE]
  afs-spec render SLICE [--spec ...] [--ledger ...] [--results FILE] [--out FILE]

Spec files live under `.migration/spec/<slice>/*.yaml` (schemas/spec.schema.json). Each names a ledger
capability, and each case names the rule it proves, acts once through a public entry point (an HTTP request
or a management command) and says what must come back. Nothing in a spec names a module, class or function
of the code, so a refactor that keeps the behaviour can't break one.

* `check`: every file is valid, every case has an assertion (the schema refuses an empty `then`), and every
  `rule:` exists in its capability's ledger entry. With --require, every rule of every capability that has a
  spec file must be proved by at least one case.
* `run`: the cases run through the stack's adapter (`afs_spec_django.py` for Django). A failure prints the
  expected and actual response as text, so it reads as a diff. Results go to --results (default
  `.migration/runs/spec-results.json`) for `render`. A capability whose ledger status isn't `in-progress` or
  `migrated` isn't built yet: its cases are reported as pending, not run, so the Characterizer can write
  the spec before the Migrator builds the code (ADR-0062). `--all` runs them anyway.
* A **replay** case (ADR-0067) names a recorded legacy exchange (`when.replay: {recording, exchange}`): the
  runner sends its request and compares the response with the recorded one (`then.replay: {body, mask}`), so
  the recording itself is the oracle and no value is copied by hand. With --require, every tier-A capability
  with a spec replays at least one exchange, or its ledger entry says why not (`no_replay: <why>`).
* **Contracts at a boundary** (ADR-0068): `then.schema` (a JSON Schema, inline or a file from the repo root)
  checks the shape of a JSON response, for an API whose values can't be fixed; `given.gateways` puts a real
  local HTTP stub in front of each named gateway (`afs_spec_stub.py`; the profile's `spec.gateways` says how the
  target finds it), answering as the case says, and `then.sent` lists the requests the target must have sent.
  With --require, an `integration` capability with a spec has a contract case or a `no_contract` reason.
* A **property** case (ADR-0069) has `forall:` instead of examples: named ranges (`int`, `number`, `date`) or
  lists (`one_of`). The runner tries each range's edges, its middle and seeded random values (the seed is the
  case's id, so every run tries the same inputs; `--samples` sets how many), and on a failure searches toward
  the start of each range for the smallest input that still fails, which is the one it reports. `then.number`
  checks a number taken from the response against bounds, which is how a property states an invariant.
* `rulings` (CI, needs `gh`): every `ruling:` a case cites is a decided quirk: its issue is closed as completed
  and carries the operator's `**Ruling ...` comment (ADR-0074). `check` already refuses a ruling that isn't
  `owner/repo#N` listed in the capability's ledger `quirks`.
* No case checks only a status (a 204 or 304 aside), and with --require every status the legacy app was
  recorded answering on a tier-A capability's endpoint (from the ledger's recordings and the spec's replays)
  is proved by a case (ADR-0074): the error paths observed can't drop out of the spec.
* `render`: the slice's living spec, as one readable page: capability, rule, cases and their last results.

This file is the harness's. A target's agents may not change it or its adapter, and only a Characterizer
ticket may change `.migration/spec/` (ADR-0061, ADR-0062).
"""
import argparse
import contextlib
import random
import copy
import datetime as dt
import html
import json
import pathlib
import re
import sys

import yaml

HERE = pathlib.Path(__file__).resolve().parent
SCHEMA = HERE.parent / "schemas" / "spec.schema.json"           # in the harness repository
if not SCHEMA.exists():
    SCHEMA = HERE / "schemas" / "spec.schema.json"              # installed: .migration/harness/tools/schemas
PLACEHOLDER = re.compile(r"\{([a-z_][a-z0-9_]*)\}")


class SpecError(Exception):
    pass


# ---------------------------------------------------------------- loading and checking

def spec_files(spec_dir, slice_=None):
    base = pathlib.Path(spec_dir)
    if not base.is_dir():
        return []
    folders = [base / slice_] if slice_ else sorted(p for p in base.iterdir() if p.is_dir() and not p.name.startswith("."))
    return [p for folder in folders for p in sorted(folder.glob("*.yaml"))]


def load(path):
    try:
        return yaml.safe_load(pathlib.Path(path).read_text(encoding="utf-8")) or {}
    except yaml.YAMLError as e:
        raise SpecError(f"{path}: not YAML: {e}")


def schema_errors(doc, path):
    try:
        import jsonschema
    except ImportError:                                 # the validator still checks rules and assertions below
        return []
    schema = json.loads(SCHEMA.read_text(encoding="utf-8"))
    validator = jsonschema.Draft202012Validator(schema)
    return [f"{path}: {'/'.join(str(p) for p in e.absolute_path) or '(top)'}: {e.message}"
            for e in sorted(validator.iter_errors(doc), key=lambda e: list(e.absolute_path))]


def ledger_rules(ledger_dir, capability):
    path = pathlib.Path(ledger_dir) / f"{capability}.yaml"
    if not path.exists():
        return None
    doc = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    return {r.get("id") for r in doc.get("rules") or [] if isinstance(r, dict)}


BUILT = {"in-progress", "migrated"}


def ledger_field(ledger_dir, capability, key):
    path = pathlib.Path(ledger_dir) / f"{capability}.yaml"
    if not path.exists():
        return None
    return (yaml.safe_load(path.read_text(encoding="utf-8")) or {}).get(key)


def load_exchange(root, replay):
    """The recorded exchange a replay case names, or a SpecError saying what is wrong."""
    path = pathlib.Path(root) / replay["recording"]
    try:
        doc = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        raise SpecError(f"recording {replay['recording']!r} can't be read as JSON: {e}")
    if replay.get("under") and isinstance(doc, dict):
        doc = doc.get(replay["under"])
    ex = doc.get(replay["exchange"]) if isinstance(doc, dict) else None
    if not isinstance(ex, dict) or not isinstance(ex.get("request"), dict) or not isinstance(ex.get("response"), dict):
        raise SpecError(f"recording {replay['recording']!r} has no exchange {replay['exchange']!r} with a request "
                        f"and a response (it has: {', '.join(list(doc)[:8]) if isinstance(doc, dict) else 'no names'})")
    req = ex["request"]
    if not str(req.get("path", "")).startswith("/") or str(req.get("method", "")).upper() not in (
            "GET", "POST", "PUT", "PATCH", "DELETE"):
        raise SpecError(f"exchange {replay['exchange']!r} in {replay['recording']!r} needs request.method and a "
                        "request.path starting with /")
    return ex


def forall_problems(case, path, i):
    out = []
    if case.get("examples"):
        out.append(f"{path}: case {i + 1} has both `forall` and `examples`: a property draws its own inputs")
    for name, gen in case["forall"].items():
        try:
            kind, lo, hi = bounds(gen)
        except (StopIteration, ValueError, TypeError, KeyError) as e:
            out.append(f"{path}: case {i + 1}: forall {name} isn't a valid range ({e})")
            continue
        if kind != "one_of" and lo > hi:
            out.append(f"{path}: case {i + 1}: forall {name} runs from {lo} down to {hi}")
    used = set(PLACEHOLDER.findall(json.dumps([case.get("given"), case["when"], case["then"]])))
    missing = used - set(case["forall"])
    if missing:
        out.append(f"{path}: case {i + 1} uses {{{', '.join(sorted(missing))}}} but its forall has no such name")
    return out


def schema_problems(root, case, path, i):
    schema = case["then"].get("schema")
    if schema is None:
        return []
    try:
        if isinstance(schema, str):
            schema = json.loads((pathlib.Path(root) / schema).read_text(encoding="utf-8"))
        import jsonschema
        jsonschema.Draft202012Validator.check_schema(schema)
    except ImportError:
        return []
    except (OSError, ValueError) as e:
        return [f"{path}: case {i + 1}: schema {case['then']['schema']!r} can't be read as JSON: {e}"]
    except Exception as e:  # noqa: BLE001 (jsonschema's SchemaError)
        return [f"{path}: case {i + 1}: schema isn't a valid JSON Schema: {str(e).splitlines()[0]}"]
    return []


def replay_problems(root, case, path, i):
    out = []
    if "replay" not in case["then"]:
        out.append(f"{path}: case {i + 1} replays an exchange but `then` has no `replay` (body: exact, text, json or "
                   "ignore) to compare it with")
    for row in example_rows(case):
        try:
            load_exchange(root, substitute(case["when"]["replay"], row))
        except (SpecError, KeyError) as e:
            out.append(f"{path}: case {i + 1}: {e}")
    return out


def example_rows(case):
    ex = case.get("examples")
    return [dict(zip(ex["columns"], r)) for r in ex["rows"]] if ex else [{}]


def ledger_status(ledger_dir, capability):
    path = pathlib.Path(ledger_dir) / f"{capability}.yaml"
    if not path.exists():
        return None
    return (yaml.safe_load(path.read_text(encoding="utf-8")) or {}).get("status")


def unspecced_rules(ledger_dir, capability):
    """Rules the ledger says no case can prove (`no_spec: <why>`)."""
    path = pathlib.Path(ledger_dir) / f"{capability}.yaml"
    doc = yaml.safe_load(path.read_text(encoding="utf-8")) or {} if path.exists() else {}
    return {r.get("id") for r in doc.get("rules") or [] if isinstance(r, dict) and r.get("no_spec")}


def case_rules(case):
    r = case.get("rule")
    return [r] if isinstance(r, str) else list(r or [])


RULING = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$")
STATUS_ONLY_OK = {204, 304}          # no body to check


def ledger_doc(ledger_dir, capability):
    path = pathlib.Path(ledger_dir) / f"{capability}.yaml"
    return (yaml.safe_load(path.read_text(encoding="utf-8")) or {}) if path.exists() else {}


def endpoint_of(entry):
    """`METHOD /path` from a ledger entry's `source.graph_node` (`endpoint:<file>:METHOD /path`), else None."""
    node = str(((entry.get("source") or {}).get("graph_node")) or "")
    m = re.match(r"^endpoint:.*?:((?:GET|POST|PUT|PATCH|DELETE) /\S*)$", node)
    return m.group(1) if m else None


def recorded_outcomes(root, recordings, endpoint):
    """{status: "recording#exchange"} for every recorded legacy exchange of `endpoint` (a key equal to it, or it
    followed by a space and a variant name) in the given recording files, top level or one level down."""
    out = {}
    for rec in sorted(set(recordings)):
        try:
            doc = json.loads((pathlib.Path(root) / rec).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        groups = [doc] + [v for v in doc.values() if isinstance(v, dict)] if isinstance(doc, dict) else []
        for group in groups:
            for key, ex in group.items():
                if not isinstance(ex, dict) or not isinstance(ex.get("response"), dict):
                    continue
                if key == endpoint or str(key).startswith(endpoint + " "):
                    status = ex["response"].get("status")
                    if isinstance(status, int):
                        out.setdefault(status, f"{rec}#{key}")
    return out


def outcome_problems(path, cap, entry, doc, root):
    """ADR-0074: every status the legacy app was recorded answering on the capability's endpoint is proved by a
    case, so the error paths the Characterizer observed can't be left out of the spec."""
    endpoint = endpoint_of(entry)
    if not endpoint:
        return []
    recordings = [e for e in entry.get("evidence") or [] if isinstance(e, str) and e.endswith(".json")]
    recordings += [c["when"]["replay"]["recording"] for c in doc["cases"]
                   if isinstance((c.get("when") or {}).get("replay"), dict)
                   and "{" not in str(c["when"]["replay"].get("recording"))]
    recorded = recorded_outcomes(root, recordings, endpoint)
    if not recorded:
        return []
    try:
        cases = expand(doc, path, root)
    except (SpecError, KeyError, TypeError):
        return []                                  # the other checks report why the file doesn't expand
    proved = set()
    for c in cases:
        then = c.get("then") or (c.get("template") or {}).get("then") or {}
        if isinstance(then.get("status"), int):
            proved.add(then["status"])
    return [f"{path}: the legacy app answered {endpoint} with {status} ({where}), but no case of {cap} proves a "
            f"{status}: add a case for that outcome (replay the exchange, or a case with `then.status: {status}` and "
            "what comes back)"
            for status, where in sorted(recorded.items()) if status not in proved]


RULED = re.compile(r"\*\*Ruling\b")


def spec_rulings(spec_dir):
    """{ruling: [where it's cited]} for every case that names one."""
    out = {}
    for path in spec_files(spec_dir):
        try:
            doc = load(path)
        except SpecError:
            continue
        for i, case in enumerate((doc or {}).get("cases") or []):
            if isinstance(case, dict) and case.get("ruling"):
                out.setdefault(str(case["ruling"]), []).append(f"{path}: case {i + 1}")
    return out


def ruling_problems(rulings, fetch):
    """ADR-0074: a ruling a case cites is a decided quirk: its issue is closed as completed and carries the
    ruling comment (`**Ruling ...`). `fetch(ref)` returns (issue, comments) from GitHub, or raises."""
    problems = []
    for ref, where in sorted(rulings.items()):
        if not RULING.match(ref):
            continue                                       # `check` reports the malformed reference
        try:
            issue, comments = fetch(ref)
        except Exception as e:  # noqa: BLE001 (an unreadable ruling is not a decided one)
            problems.append(f"{where[0]}: ruling {ref} can't be read from GitHub ({e}); a ruling must be a real issue")
            continue
        if issue.get("pull_request") is not None:
            problems.append(f"{where[0]}: ruling {ref} is a pull request, not a quirk issue")
        elif issue.get("state") != "closed" or issue.get("state_reason") not in (None, "completed"):
            problems.append(f"{', '.join(where)}: ruling {ref} isn't decided yet (the quirk issue is "
                            f"{issue.get('state')}{'/' + issue['state_reason'] if issue.get('state_reason') else ''}): "
                            "keep the legacy behaviour with its `oracle` until the operator rules")
        elif not any(RULED.search(c.get("body") or "") for c in comments):
            problems.append(f"{where[0]}: ruling {ref} is closed but carries no ruling comment (`**Ruling ...`): "
                            "the operator's decision must be on the issue")
    return problems


def github_fetch(ref):
    import subprocess
    repo, num = ref.split("#")
    def api(path):
        r = subprocess.run(["gh", "api", path], capture_output=True, text=True)
        if r.returncode:
            raise RuntimeError((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip()
                               else f"gh api exit {r.returncode}")
        return json.loads(r.stdout)
    return api(f"repos/{repo}/issues/{num}"), api(f"repos/{repo}/issues/{num}/comments?per_page=100")


def check(spec_dir, ledger_dir, require=False):
    """Problems with the spec, as strings; empty when it is sound."""
    problems = []
    proved = {}
    for path in spec_files(spec_dir):
        try:
            doc = load(path)
        except SpecError as e:
            problems.append(str(e))
            continue
        errs = schema_errors(doc, path)
        problems += errs
        if errs or not isinstance(doc, dict):
            continue
        cap = doc["capability"]
        known = ledger_rules(ledger_dir, cap)
        if known is None:
            problems.append(f"{path}: capability {cap} has no ledger entry (.migration/ledger/{cap}.yaml)")
            continue
        root = pathlib.Path(spec_dir).resolve().parent.parent
        replays = contracts = 0
        for i, case in enumerate(doc["cases"]):
            if "schema" in case["then"] or "sent" in case["then"]:
                contracts += 1
            problems += schema_problems(root, case, path, i)
            replay = (case.get("when") or {}).get("replay")
            if replay:
                replays += 1
                problems += replay_problems(root, case, path, i)
            elif "replay" in case.get("then", {}):
                problems.append(f"{path}: case {i + 1} has `then.replay` but no `when.replay` to compare with")
            oracle = case.get("oracle")
            if oracle and not (root / oracle).exists():
                problems.append(f"{path}: case {i + 1} ({case.get('title')!r}) names oracle {oracle!r}, which "
                                "doesn't exist: point it at the recorded legacy output the values come from")
            ruling = case.get("ruling")
            if ruling is not None:
                quirks = [str(q) for q in ledger_doc(ledger_dir, cap).get("quirks") or []]
                if not RULING.match(str(ruling)):
                    problems.append(f"{path}: case {i + 1} ({case.get('title')!r}) names ruling {ruling!r}: a ruling "
                                    "is the quirk issue that decided it, as `owner/repo#N`")
                elif str(ruling) not in quirks:
                    problems.append(f"{path}: case {i + 1} ({case.get('title')!r}) names ruling {ruling}, which "
                                    f"{cap}'s ledger entry doesn't list under `quirks` "
                                    f"({', '.join(quirks) or 'none'}): only a quirk raised on this capability can "
                                    "set its expected values")
            then_keys = set(case.get("then") or {})
            if then_keys == {"status"} and case["then"]["status"] not in STATUS_ONLY_OK and not replay:
                problems.append(f"{path}: case {i + 1} ({case.get('title')!r}) checks only the status: a status alone "
                                "doesn't prove the behaviour, so also check what comes back (`text`, `json`, "
                                "`replay`, ...)")
            if require and not oracle and not replay and not case.get("ruling"):     # a replay is its own oracle
                problems.append(f"{path}: case {i + 1} ({case.get('title')!r}) says neither where its expected "
                                "values come from (`oracle:` a recorded legacy output) nor which quirk ruling "
                                "sets them (`ruling:`)")
            for rule in case_rules(case):
                if rule not in known:
                    problems.append(f"{path}: case {i + 1} ({case.get('title')!r}) names rule {rule!r}, which "
                                    f"{cap} doesn't list (its rules: {', '.join(sorted(known)) or 'none'})")
                proved.setdefault(cap, set()).add(rule)
            if case.get("forall"):
                problems += forall_problems(case, path, i)
            ex = case.get("examples")
            if ex:
                width = len(ex["columns"])
                for j, row in enumerate(ex["rows"]):
                    if len(row) != width:
                        problems.append(f"{path}: case {i + 1} example row {j + 1} has {len(row)} values for "
                                        f"{width} columns")
                used = set(PLACEHOLDER.findall(json.dumps([case.get("given"), case["when"], case["then"]])))
                missing = used - set(ex["columns"])
                if missing:
                    problems.append(f"{path}: case {i + 1} uses {{{', '.join(sorted(missing))}}} but its examples "
                                    "have no such column")
        if require and not contracts and ledger_field(ledger_dir, cap, "kind") == "integration" \
                and not ledger_field(ledger_dir, cap, "no_contract"):
            problems.append(f"{path}: {cap} is an integration, so its contract is checked at the boundary: add a case "
                            "with `then.schema` (the shape of what it answers) or `given.gateways` and `then.sent` "
                            "(what it sends), or say why none can be in its ledger entry (`no_contract`)")
        if require and not replays and ledger_field(ledger_dir, cap, "characterization_tier") == "A" \
                and not ledger_field(ledger_dir, cap, "no_replay"):
            problems.append(f"{path}: {cap} was characterized at tier A, so its recorded exchanges can be replayed: add "
                            "a replay case (`when.replay`), or say why none can be in its ledger entry (`no_replay`)")
        if require and ledger_field(ledger_dir, cap, "characterization_tier") == "A":
            problems += outcome_problems(path, cap, ledger_doc(ledger_dir, cap), doc, root)
        if require:
            for rule in sorted((known or set()) - proved.get(cap, set()) - unspecced_rules(ledger_dir, cap)):
                problems.append(f"{path}: rule {rule!r} of {cap} has no case; add one that proves it, or a "
                                "`no_spec` reason on the rule in the ledger")
    return problems


# ---------------------------------------------------------------- expanding and comparing

def substitute(value, row):
    if isinstance(value, str):
        whole = PLACEHOLDER.fullmatch(value)
        if whole:                                          # "{fee}" alone keeps the row value's own type
            return row[whole.group(1)]
        return PLACEHOLDER.sub(lambda m: str(row[m.group(1)]), value)
    if isinstance(value, list):
        return [substitute(v, row) for v in value]
    if isinstance(value, dict):
        return {k: substitute(v, row) for k, v in value.items()}
    return value


def merge_given(*parts):
    out = {}
    for g in parts:
        for k, v in (g or {}).items():
            out[k] = (out.get(k) or []) + list(v) if isinstance(v, list) else v
    return out


def spec_root(path):
    """The repository root of a spec file at <root>/.migration/spec/<slice>/<file>.yaml."""
    parents = pathlib.Path(path).resolve().parents
    return parents[3] if len(parents) > 3 else pathlib.Path(".")


def resolve_replay(case, root):
    """A replay case as the HTTP request it replays, with the recorded response to compare against (ADR-0067)."""
    replay = case["when"].get("replay")
    if not replay:
        return case
    ex = load_exchange(root, replay)
    req, resp = ex["request"], ex["response"]
    http = {"method": str(req["method"]).upper(), "path": req["path"]}
    for key in ("form", "json", "headers"):
        if req.get(key) is not None:
            http[key] = req[key]
    then = dict(case["then"])
    then.setdefault("status", resp.get("status"))
    then["replay"] = dict(then["replay"], expected=resp.get("body", ""),
                          source=f"{replay['recording']}#{replay['exchange']}")
    return dict(case, when={"http": http}, then=then)


def resolve_schema(case, root):
    schema = case["then"].get("schema")
    if isinstance(schema, str):
        try:
            loaded = json.loads((pathlib.Path(root) / schema).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return case                                 # check reports it; the verdict fails with the path
        return dict(case, then=dict(case["then"], schema=loaded))
    return case


def expand(doc, path, root=None):
    """The concrete cases of one spec file, with the background and example rows applied."""
    bg = (doc.get("background") or {}).get("given")
    root = root or spec_root(path)
    out = []
    for i, case in enumerate(doc["cases"]):
        if case.get("forall"):
            cid = f"{path}#{i + 1}"
            out.append({"id": cid, "title": case["title"], "capability": doc["capability"], "rules": case_rules(case),
                        "property": {"forall": case["forall"], "samples": samples(case["forall"], cid, SAMPLES[0])},
                        "template": {"given": merge_given(bg, case.get("given")), "when": case["when"],
                                     "then": case["then"]}, "root": str(root)})
            continue
        ex = case.get("examples")
        rows = [dict(zip(ex["columns"], r)) for r in ex["rows"]] if ex else [{}]
        for j, row in enumerate(rows):
            title = case["title"] + (" — " + ", ".join(f"{k}={v}" for k, v in row.items()) if row else "")
            out.append({"id": f"{path}#{i + 1}" + (f".{j + 1}" if ex else ""), "title": title,
                        "capability": doc["capability"], "rules": case_rules(case),
                        "given": substitute(merge_given(bg, case.get("given")), row),
                        "when": substitute(copy.deepcopy(case["when"]), row),
                        "then": substitute(copy.deepcopy(case["then"]), row)})
            out[-1] = resolve_schema(resolve_replay(out[-1], root), root)
    return out


SAMPLES = [25]           # inputs tried per property case; `run --samples` sets it


def bounds(gen):
    """(kind, low, high) of a range generator, or ("one_of", values, None)."""
    if "one_of" in gen:
        return "one_of", list(gen["one_of"]), None
    kind = next(k for k in ("int", "number", "date") if k in gen)
    r = gen[kind]
    if kind == "date":
        return kind, dt.date.fromisoformat(str(r["from"])), dt.date.fromisoformat(str(r["to"]))
    return kind, r["from"], r["to"]


def pick(gen, rng, where):
    """A value of a generator: `where` is "low", "high", "mid", "low+1", "high-1" or "random"."""
    kind, lo, hi = bounds(gen)
    if kind == "one_of":
        return lo[{"low": 0, "high": -1}.get(where, rng.randrange(len(lo)))] if where != "mid" else lo[len(lo) // 2]
    span = (hi - lo).days if kind == "date" else hi - lo
    step = 1 if kind != "number" else 10 ** -(gen["number"].get("places", 2))
    offset = {"low": 0, "high": span, "mid": span / 2, "low+1": min(step, span), "high-1": max(span - step, 0)}.get(where)
    if offset is None:
        offset = rng.uniform(0, span) if kind == "number" else rng.randint(0, int(span))
    if kind == "date":
        return (lo + dt.timedelta(days=int(offset))).isoformat()
    if kind == "int":
        return int(lo + int(offset))
    return round(lo + offset, gen["number"].get("places", 2))


def samples(forall, seed, n):
    """The inputs a property case tries: every range's edges and middle (others at their low end), then seeded
    random combinations, without repeats, n in all."""
    rng = random.Random(seed)
    names = sorted(forall)
    out, seen = [], set()

    def add(row):
        key = json.dumps(row, sort_keys=True, default=str)
        if key not in seen:
            seen.add(key)
            out.append(row)
    for name in names:
        for where in ("low", "low+1", "mid", "high-1", "high"):
            add({k: pick(forall[k], rng, where if k == name else "low") for k in names})
    tries = 0
    while len(out) < n and tries < n * 20:
        tries += 1
        add({k: pick(forall[k], rng, "random") for k in names})
    return out[:n]


def shrink(forall, row, fails, budget=24):
    """The smallest input that still fails: for each range, binary search from its low end toward the failing
    value (a list moves toward its first value). `fails(row)` runs the case."""
    best = dict(row)
    for name in sorted(forall):
        kind, lo, _ = bounds(forall[name])
        if kind == "one_of":
            for v in lo:
                if v == best[name] or budget <= 0:
                    break
                budget -= 1
                trial = dict(best, **{name: v})
                if fails(trial):
                    best = trial
                    break
            continue
        as_num = (lambda v: dt.date.fromisoformat(v).toordinal()) if kind == "date" else (lambda v: v)
        from_num = (lambda x: dt.date.fromordinal(int(x)).isoformat()) if kind == "date" else (
            (lambda x: int(x)) if kind == "int" else (lambda x: round(x, forall[name]["number"].get("places", 2))))
        low, high = as_num(lo.isoformat() if kind == "date" else lo), as_num(best[name])
        step = 1 if kind != "number" else 10 ** -(forall[name]["number"].get("places", 2))
        while high - low > step and budget > 0:
            budget -= 1
            mid = from_num((low + high) / 2)
            trial = dict(best, **{name: mid})
            if fails(trial):
                best, high = trial, as_num(mid)
            else:
                low = as_num(mid)
        if budget > 0 and best[name] != from_num(low):
            budget -= 1
            trial = dict(best, **{name: from_num(low)})
            if fails(trial):
                best = trial
    return best


def contains(actual, expected):
    """Objects match on the keys given; everything else matches exactly. Numbers and numeric strings agree."""
    if isinstance(expected, dict):
        return isinstance(actual, dict) and all(k in actual and contains(actual[k], v) for k, v in expected.items())
    if isinstance(expected, list):
        return isinstance(actual, list) and len(actual) == len(expected) and all(
            contains(a, e) for a, e in zip(actual, expected))
    if isinstance(expected, (int, float)) and not isinstance(expected, bool) and isinstance(actual, str):
        try:
            return float(actual) == float(expected)
        except ValueError:
            return False
    if isinstance(expected, str) and isinstance(actual, (int, float)) and not isinstance(actual, bool):
        try:
            return float(expected) == float(actual)
        except ValueError:
            return False
    return actual == expected


def verdict(then, result):
    """The assertions that failed, as readable lines."""
    failed = []
    if "status" in then and result.get("status") != then["status"]:
        failed.append(f"status: expected {then['status']}, got {result.get('status')}")
    if "json" in then:
        if result.get("json") is None:
            failed.append("json: expected a JSON body, got none")
        elif not contains(result["json"], then["json"]):
            failed.append("json: expected it to contain\n" + printer(then["json"]) + "got\n" + printer(result["json"]))
    body = result.get("text") or ""
    for t in then.get("text") or []:
        if str(t) not in body:
            failed.append(f"text: {t!r} not found")
    for t in then.get("not_text") or []:
        if str(t) in body:
            failed.append(f"not_text: {t!r} found")
    if "replay" in then:
        failed += replay_verdict(then["replay"], result)
    if "sent" in then:
        failed += sent_verdict(then["sent"], result.get("sent") or {})
    if "number" in then:
        failed += number_verdict(then["number"], result)
    if "schema" in then:
        failed += schema_verdict(then["schema"], result)
    for k, v in (then.get("headers") or {}).items():
        got = (result.get("headers") or {}).get(k.lower())
        if got != v:
            failed.append(f"header {k}: expected {v!r}, got {got!r}")
    return failed


def number_verdict(spec, result):
    """A number taken from the body (the pattern's first group) is within bounds."""
    m = re.search(spec["pattern"], result.get("text") or "")
    if not m:
        return [f"number: {spec['pattern']!r} not found"]
    try:
        value = float(m.group(1) if m.groups() else m.group(0))
    except ValueError:
        return [f"number: {m.group(0)!r} isn't a number"]
    out = []
    if "min" in spec and value < float(spec["min"]):
        out.append(f"number: {value:g} is below {spec['min']}")
    if "max" in spec and value > float(spec["max"]):
        out.append(f"number: {value:g} is above {spec['max']}")
    return out


def sent_verdict(expected, sent):
    """Each gateway got exactly these requests, in order: method and path equal, body containing the given text."""
    failed = []
    for name, want in expected.items():
        got = sent.get(name)
        if got is None:
            failed.append(f"sent {name}: the case didn't put a stub in front of {name} (given.gateways)")
            continue
        ok = len(got) == len(want) and all(
            g["method"] == w["method"].upper() and g["path"] == w["path"] and str(w.get("body", "")) in g["body"]
            for g, w in zip(got, want))
        if not ok:
            failed.append(f"sent {name}: expected\n" + printer(want) + "the target sent\n"
                          + printer([{k: g[k] for k in ("method", "path", "body") if g.get(k) or k != "body"} for g in got]))
    return failed


def schema_verdict(schema, result):
    if isinstance(schema, str):
        return [f"schema: {schema!r} can't be read as a JSON Schema"]
    try:
        import jsonschema
    except ImportError:
        return ["schema: jsonschema isn't installed, so the contract can't be checked"]
    body = result.get("json")
    if body is None:
        return ["schema: expected a JSON body, got none"]
    errs = sorted(jsonschema.Draft202012Validator(schema).iter_errors(body), key=lambda e: list(e.absolute_path))
    return [f"schema: {'/'.join(str(p) for p in e.absolute_path) or '(top)'}: {e.message}" for e in errs[:10]]


TAG = re.compile(r"<[^>]+>")


def normalize(body, mode, masks):
    text = str(body or "")
    if mode == "text":
        text = " ".join(html.unescape(TAG.sub(" ", text)).split())
    elif mode == "exact":
        text = "\n".join(line.rstrip() for line in text.replace("\r\n", "\n").split("\n")).strip("\n")
    for m in masks or []:
        text = re.sub(m, "<masked>", text)
    return text


def replay_verdict(replay, result):
    """The recorded body against the target's, after the case's normalization and masks."""
    mode, masks = replay["body"], replay.get("mask")
    if mode == "ignore":
        return []
    if mode == "json":
        try:
            want = json.loads(normalize(replay["expected"], "json", masks))
            got = json.loads(normalize(result.get("text"), "json", masks))
        except ValueError as e:
            return [f"replay {replay.get('source')}: body isn't JSON on both sides ({e})"]
        if want == got:
            return []
        return [f"replay {replay.get('source')}: JSON differs; recorded\n" + printer(want) + "target\n" + printer(got)]
    want, got = normalize(replay["expected"], mode, masks), normalize(result.get("text"), mode, masks)
    if want == got:
        return []
    return [f"replay {replay.get('source')}: body ({mode}) differs\n  recorded: {want[:400]!r}\n  target:   {got[:400]!r}"]


def printer(value):
    """Stable, diffable text for a response part."""
    return yaml.safe_dump(value, sort_keys=True, allow_unicode=True, default_flow_style=False, width=100)


# ---------------------------------------------------------------- running

def adapter_for(name, gateways=None):
    if name == "django":
        sys.path.insert(0, str(HERE))
        import afs_spec_django
        return afs_spec_django.DjangoAdapter(gateways=gateways)
    raise SpecError(f"no spec adapter {name!r} (the stack pack's profile names one under spec.adapter)")


def run_cases(cases, adapter, pending=()):
    """Run each case; a case whose capability is in `pending` is recorded as pending, not run."""
    results = [{"id": c["id"], "title": c["title"], "capability": c["capability"], "rules": c["rules"],
                "passed": None, "pending": True, "failures": []} for c in cases if c["capability"] in pending]
    cases = [c for c in cases if c["capability"] not in pending]
    if not cases:
        return results
    with contextlib.ExitStack() as stack:
        adapter.setup()
        stack.callback(adapter.teardown)
        for case in cases:
            failed = run_property(case, adapter) if case.get("property") else run_one(case, adapter)
            results.append({"id": case["id"], "title": case["title"], "capability": case["capability"],
                            "rules": case["rules"], "passed": not failed, "failures": failed})
    return results


def run_one(case, adapter):
    try:
        with adapter.case(case["given"]):
            result = adapter.act(case["when"])
        return verdict(case["then"], result)
    except Exception as e:                     # a setup or action that raises is a failure, shown as one
        return [f"error: {type(e).__name__}: {e}"]


def run_property(case, adapter):
    """Every sample must pass; the first that fails is shrunk to the smallest failing input and reported."""
    prop, tpl = case["property"], case["template"]

    def concrete(row):
        c = {"given": substitute(copy.deepcopy(tpl["given"]), row), "when": substitute(copy.deepcopy(tpl["when"]), row),
             "then": substitute(copy.deepcopy(tpl["then"]), row)}
        return resolve_schema(resolve_replay(c, case["root"]), case["root"])

    for row in prop["samples"]:
        failed = run_one(concrete(row), adapter)
        if failed:
            smallest = shrink(prop["forall"], row, lambda r: bool(run_one(concrete(r), adapter)))
            again = run_one(concrete(smallest), adapter) or failed
            shown = ", ".join(f"{k}={v}" for k, v in sorted(smallest.items()))
            return [f"fails for {shown} (the smallest failing input found, from {len(prop['samples'])} tried)"] + again
    return []


def profile_gateways(profile=".migration/profile.yaml"):
    try:
        doc = yaml.safe_load(pathlib.Path(profile).read_text(encoding="utf-8")) or {}
    except OSError:
        return {}
    return ((doc.get("spec") or {}).get("gateways")) or {}


def profile_adapter(profile=".migration/profile.yaml"):
    try:
        doc = yaml.safe_load(pathlib.Path(profile).read_text(encoding="utf-8")) or {}
    except OSError:
        return "django"
    return ((doc.get("spec") or {}).get("adapter")) or "django"


# ---------------------------------------------------------------- rendering

def render(slice_, spec_dir, ledger_dir, results=None):
    res = {r["id"]: r for r in (results or [])}
    lines = [f"# Spec: {slice_}", "",
             "What this slice does, as the customer tests state it. Each case acts through a public entry point "
             "and names the ledger rule it proves (ADR-0061).", ""]
    for path in spec_files(spec_dir, slice_):
        doc = load(path)
        cap = doc.get("capability")
        rules = {}
        lp = pathlib.Path(ledger_dir) / f"{cap}.yaml"
        if lp.exists():
            led = yaml.safe_load(lp.read_text(encoding="utf-8")) or {}
            rules = {r.get("id"): r.get("rule") for r in led.get("rules") or [] if isinstance(r, dict)}
        lines += [f"## {doc.get('title') or cap}", f"Capability `{cap}` · `{path}`", ""]
        for i, case in enumerate(doc.get("cases") or []):
            expanded = [c for c in expand({**doc, "cases": [case]}, path)]
            for c in expanded:                                  # ids as the run wrote them
                c["id"] = c["id"].replace(f"{path}#1", f"{path}#{i + 1}", 1)
            lines.append(f"### {case['title']}")
            lines += [f"- proves **{r}**: {rules.get(r, '(not in the ledger)')}" for r in case_rules(case)]
            if case.get("oracle"):
                lines.append(f"- expected values from the legacy app: `{case['oracle']}`")
            if case.get("ruling"):
                lines.append(f"- expected values set by quirk ruling {case['ruling']}")
            for name, gen in (case.get("forall") or {}).items():
                kind, lo, hi = bounds(gen)
                lines.append(f"- for every **{name}** " + (f"in {', '.join(map(str, lo))}" if kind == "one_of"
                                                            else f"from {lo} to {hi}"))
            lines.append("")
            lines.append(f"When {describe(case['when'])}, then {describe_then(case['then'])}.")
            ex = case.get("examples")
            if ex:
                lines += ["", "| " + " | ".join(ex["columns"]) + " | result |",
                          "|" + "---|" * (len(ex["columns"]) + 1)]
                for row, c in zip(ex["rows"], expanded):
                    lines.append("| " + " | ".join(str(v) for v in row) + f" | {mark(res.get(c['id']))} |")
            else:
                lines.append(f"Result: {mark(res.get(expanded[0]['id']))}")
            lines.append("")
        unproved = [r for r in rules if not any(r in case_rules(c) for c in doc.get("cases") or [])]
        if unproved:
            lines.append("Rules no case proves yet: " + ", ".join(f"**{r}**" for r in unproved))
        lines.append("")
    return "\n".join(lines)


def mark(result):
    if not result:
        return "not run yet"
    if result.get("pending"):
        return "⏳ not built yet"
    return "✅ passed" if result["passed"] else "❌ failed"


def describe(when):
    if "replay" in when:
        r = when["replay"]
        return f"the recorded exchange `{r['exchange']}` (`{r['recording']}`) is replayed"
    if "http" in when:
        h = when["http"]
        return f"`{h['method']} {h['path']}`"
    c = when["command"]
    return f"`{c['name']} {' '.join(str(a) for a in c.get('args') or [])}`".replace(" `", "`")


def describe_then(then):
    parts = []
    if "replay" in then:
        parts.append(f"the same status and body as recorded ({then['replay']['body']})")
    if "schema" in then:
        parts.append("a body shaped as " + (f"`{then['schema']}`" if isinstance(then["schema"], str) else "the contract"))
    for name, reqs in (then.get("sent") or {}).items():
        parts.append(f"{name} was sent " + (", ".join(f"`{r['method']} {r['path']}`" for r in reqs) or "nothing"))
    if "status" in then:
        parts.append(str(then["status"]))
    if "json" in then:
        parts.append(json.dumps(then["json"], ensure_ascii=False))
    parts += [f"shows {t!r}" for t in then.get("text") or []]
    if "number" in then:
        n = then["number"]
        parts.append(f"`{n['pattern']}` is " + " and ".join(
            x for x in (f"at least {n['min']}" if "min" in n else "", f"at most {n['max']}" if "max" in n else "") if x))
    parts += [f"never {t!r}" for t in then.get("not_text") or []]
    return ", ".join(parts)


# ---------------------------------------------------------------- CLI

def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("check", "run", "render", "rulings"):
        p = sub.add_parser(name)
        p.add_argument("--spec", default=".migration/spec")
        p.add_argument("--ledger", default=".migration/ledger")
        if name == "check":
            p.add_argument("--require", action="store_true", help="every rule of a specced capability needs a case")
        if name == "run":
            p.add_argument("--slice")
            p.add_argument("--adapter")
            p.add_argument("--all", action="store_true", help="also run capabilities that aren't built yet")
            p.add_argument("--samples", type=int, default=25, help="inputs each property case tries (default 25)")
            p.add_argument("--results", default=".migration/runs/spec-results.json")
        if name == "render":
            p.add_argument("slice")
            p.add_argument("--results", default=".migration/runs/spec-results.json")
            p.add_argument("--out")
    a = ap.parse_args(argv)
    if a.cmd == "rulings":
        rulings = spec_rulings(a.spec)
        problems = ruling_problems(rulings, github_fetch)
        for p in problems:
            print(p)
        print(f"AFS-RESULT gate=spec-rulings rulings={len(rulings)} problems={len(problems)}")
        return 1 if problems else 0
    if a.cmd == "check":
        problems = check(a.spec, a.ledger, a.require)
        for p in problems:
            print(p)
        n = len(spec_files(a.spec))
        print(f"AFS-RESULT gate=spec-check files={n} problems={len(problems)}")
        return 1 if problems else 0
    if a.cmd == "run":
        problems = check(a.spec, a.ledger)
        if problems:
            for p in problems:
                print(p)
            print(f"AFS-RESULT gate=spec cases=0 failed=0 problems={len(problems)}")
            return 1
        SAMPLES[0] = max(1, a.samples)
        cases = [c for path in spec_files(a.spec, a.slice) for c in expand(load(path), path)]
        pending = set() if a.all else {c["capability"] for c in cases
                                        if ledger_status(a.ledger, c["capability"]) not in BUILT}
        runnable = [c for c in cases if c["capability"] not in pending]
        adapter = adapter_for(a.adapter or profile_adapter(), profile_gateways()) if runnable else None
        results = run_cases(cases, adapter, pending)
        for cap in sorted(pending):
            print(f"PEND {cap}: not built yet (ledger status {ledger_status(a.ledger, cap)!r}); its cases run "
                  "once the status is in-progress or migrated")
        for r in results:
            if r.get("pending"):
                continue
            print(f"{'PASS' if r['passed'] else 'FAIL'} {r['id']}: {r['title']}")
            for f in r["failures"]:
                print("    " + f.replace("\n", "\n    "))
        out = pathlib.Path(a.results)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps({"at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
                                   "results": results}, indent=1) + "\n", encoding="utf-8")
        failed = sum(r["passed"] is False for r in results)
        waiting = sum(bool(r.get("pending")) for r in results)
        line = f"AFS-RESULT gate=spec cases={len(results) - waiting} failed={failed} pending={waiting}"
        if pending:                                    # validate.py: a ticket's own capability can't be pending
            line += " pending_caps=" + ",".join(sorted(pending))
        print(line)
        return 1 if failed else 0
    if a.cmd == "render":
        results = None
        rp = pathlib.Path(a.results)
        if rp.exists():
            results = json.loads(rp.read_text(encoding="utf-8")).get("results")
        text = render(a.slice, a.spec, a.ledger, results)
        if a.out:
            pathlib.Path(a.out).write_text(text, encoding="utf-8")
        print(text)
        return 0
    return 2


if __name__ == "__main__":
    sys.path.insert(0, str(HERE))
    import afs_trace
    afs_trace.run(main)
