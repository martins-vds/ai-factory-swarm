#!/usr/bin/env python3
"""afs-run — run a gate command once, keep its full output on disk, show the agent only a summary.

Usage:
  afs-run [--ticket T] [--name N] [--runs-dir DIR] [--highlights K] [--tail N] -- <command> [args...]

Behavior (ADR-0015):
  * Runs the command exactly once. stdout+stderr go to
    <runs-dir>/<ticket>/<UTC timestamp>-<name>.log (byte-for-byte; this file is the gate evidence).
  * Prints a compact summary: exit code, duration, size, the log path, up to K failure-looking lines
    (with line numbers in the log), and — on failure — the last N lines.
  * Appends one JSON record per run to <runs-dir>/<ticket>/runs.jsonl.
  * Appends one row per run to the committed run journal <journal-dir>/<ticket>.md (default
    .migration/evidence/runs/, when a .migration/ folder exists): time, gate, exit, seconds, command,
    the log's SHA-256 and its first highlight. Raw logs stay out of git; the journal is the durable
    record that the run happened and what it showed. Commit it with your work.
  * Exits with the command's exit code, so gates fail when the command fails.
  * Flaky runs are recorded, never hidden (ADR-0070). Each record carries a fingerprint of the code it ran
    on (a git tree of the working tree, the session's records under `.migration/` left out). When a command passes on code where the same
    command failed before, the earlier failure was flaky: afs-run prints `AFS-FLAKY` and appends what failed
    (the failing test ids from the failed log) to `.migration/evidence/flaky/<ticket>.md`, which is committed
    with the work. The afs-flaky workflow turns each record into a ticket.

Defaults: ticket = $AFS_TICKET or "adhoc"; runs-dir = $AFS_RUNS_DIR or ".migration/runs".
Everyday shell commands go through RTK instead (rtk hook); afs-run is for gate runs, where the raw log
must be kept exactly.
"""
import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time

FAILURE = re.compile(
    r"(?i)(\berror\b|\berrors?:|\bfail(?:ed|ure|s)?\b|\bexception\b|traceback|\bassert(?:ion)?|"
    r"\bpanic\b|\bfatal\b|BUILD FAILURE|<<< (?:FAILURE|ERROR)!|\bE {2,})")
NOT_FAILURE = re.compile(
    r"(?i)(\b0 (?:failed|failures|errors)\b|Failures: 0, Errors: 0|\bno errors\b|BUILD SUCCESS|"
    r"-Werror|\bfailfast\b|\b0 error\(s\))")


def slug(text, limit=40):
    s = re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip("-._")
    return (s or "run")[:limit]


def summarize(lines, k, tail, failed):
    out, seen = [], set()
    for n, line in enumerate(lines, 1):
        stripped = line.rstrip()
        if FAILURE.search(stripped) and not NOT_FAILURE.search(stripped):
            key = re.sub(r"\d+", "#", stripped.strip())
            if key in seen:
                continue
            seen.add(key)
            out.append(f"  {n:>6}: {stripped[:240]}")
            if len(out) >= k:
                break
    parts = []
    if out:
        parts.append("-- highlights (log line: text) --")
        parts.extend(out)
    if failed or not out:
        last = [l.rstrip()[:240] for l in lines[-tail:]] if tail > 0 else []
        if last:
            parts.append(f"-- last {len(last)} line(s) --")
            parts.extend("  " + l for l in last)
    return parts


def cell(text, limit=120):
    return text.replace("|", "\\|").replace("`", "'").strip()[:limit]


RESULT = re.compile(r"^AFS-RESULT (\S.*)$")
HEADER = "| UTC | Gate | Exit | Seconds | Command | Log SHA-256 | First highlight | Result |\n"
RULE = "|---|---|---|---|---|---|---|---|\n"
OLD_HEADER = "| UTC | Gate | Exit | Seconds | Command | Log SHA-256 | First highlight |"


def result_of(lines):
    """The last `AFS-RESULT key=value …` line a harness gate tool printed (ADR-0017), or ''."""
    for line in reversed(lines):
        m = RESULT.match(line.strip())
        if m:
            return m.group(1).strip()
    return ""


def upgrade(path):
    """Add the Result column to a journal written before ADR-0017 (existing rows get an empty cell)."""
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    if OLD_HEADER not in text or "| Result |" in text:
        return
    out = []
    for line in text.splitlines(keepends=True):
        if line.startswith(OLD_HEADER):
            out.append(HEADER)
        elif line.startswith("|---|"):
            out.append(RULE)
        elif line.startswith("| 2"):
            out.append(line.rstrip("\n") + "  |\n")
        else:
            out.append(line)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("".join(out))


def journal(folder, ticket, record, sha, parts, result=""):
    """Append one row to the committed run journal for this ticket."""
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, f"{ticket}.md")
    new = not os.path.exists(path)
    if not new:
        upgrade(path)
    first = next((p.split(":", 1)[1].strip() for p in parts if re.match(r"\s+\d+:", p)), "")
    with open(path, "a", encoding="utf-8") as fh:
        if new:
            fh.write(f"# Run journal: {ticket}\n\nWritten by `afs-run`, one row per gate run. Raw logs are not "
                     f"committed; the SHA-256 identifies the exact log. Result is the gate tool's own "
                     f"`AFS-RESULT` line.\n\n" + HEADER + RULE)
        fh.write(f"| {record['ts']} | {record['name']} | {record['exit']} | {record['seconds']} | "
                 f"`{cell(record['command'], 400)}` | `{sha[:16]}` | {cell(first)} | {cell(result, 200)} |\n")


FAILED_TEST = re.compile(r"^(?:FAILED|ERROR) (\S+::\S+)")


# The session's own records, which every run writes: left out so they don't make each run look like new code.
# Everything else under .migration/ (the spec, the ledger, the characterization harness and its recordings, the
# plan) is an input to some gate, so it counts (ADR-0078: an edited spec is a fix, not a flaky pass).
RECORDS = ("runs", "evidence", "costs", "returns", "handoffs")


def tree_fingerprint():
    """The git tree of the working tree as it is now (tracked and untracked files, the session's records under
    `.migration/` left out), or None outside a git checkout. Two runs with the same fingerprint ran on the same
    code."""
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=20)
        if top.returncode:
            return None
        with tempfile.TemporaryDirectory() as d:
            env = {**os.environ, "GIT_INDEX_FILE": os.path.join(d, "index")}
            cwd = top.stdout.strip()
            add = ["git", "add", "-A", "--", "."] + [f":(exclude).migration/{r}" for r in RECORDS]
            for args in (["git", "read-tree", "HEAD"], add):
                if subprocess.run(args, cwd=cwd, env=env, capture_output=True, timeout=120).returncode:
                    return None
            out = subprocess.run(["git", "write-tree"], cwd=cwd, env=env, capture_output=True, text=True, timeout=60)
            return out.stdout.strip() or None
    except (OSError, subprocess.TimeoutExpired):
        return None


def earlier_failure(runs_file, command, tree):
    """The latest earlier run of this command on the same code, if it failed; else None."""
    if not tree or not os.path.exists(runs_file):
        return None
    last = None
    with open(runs_file, encoding="utf-8") as fh:
        for line in fh:
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("command") == command and r.get("tree") == tree:
                last = r
    return last if last and last.get("exit") not in (0, None) else None


def record_flaky(ticket, failed, passed):
    """Append the flaky run to the ticket's committed evidence; return the file (None without .migration/)."""
    if not os.path.isdir(".migration"):
        return None
    tests = []
    try:
        with open(failed["log"], encoding="utf-8", errors="replace") as fh:
            tests = sorted({m.group(1) for line in fh if (m := FAILED_TEST.match(line))})
    except OSError:
        pass
    folder = os.path.join(".migration", "evidence", "flaky")
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, f"{ticket}.md")
    new = not os.path.exists(path)
    with open(path, "a", encoding="utf-8") as fh:
        if new:
            fh.write(f"# Flaky runs: {ticket}\n\nWritten by afs-run (ADR-0070): each section is a gate command that "
                     "failed and then passed on the same code. Commit this file; the afs-flaky workflow opens a "
                     "ticket for each test.\n")
        fh.write(f"\n## `{passed['command']}`\n"
                 f"- failed: {failed['ts']} (exit {failed['exit']}, log `{failed['log']}`)\n"
                 f"- passed: {passed['ts']}, same code (tree `{passed['tree'][:12]}`)\n"
                 f"- tests that failed: " + (", ".join(f"`{t}`" for t in tests) or "none named in the log") + "\n")
    return path, tests


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if "--" not in argv:
        print("usage: afs-run [options] -- <command> [args...]", file=sys.stderr)
        return 2
    i = argv.index("--")
    opts, cmd = argv[:i], argv[i + 1:]
    if not cmd:
        print("afs-run: no command given after --", file=sys.stderr)
        return 2
    ap = argparse.ArgumentParser(prog="afs-run")
    ap.add_argument("--ticket", default=os.environ.get("AFS_TICKET", "adhoc"))
    ap.add_argument("--name", default=None)
    ap.add_argument("--runs-dir", default=os.environ.get("AFS_RUNS_DIR", ".migration/runs"))
    ap.add_argument("--highlights", type=int, default=20)
    ap.add_argument("--tail", type=int, default=15)
    ap.add_argument("--journal-dir", default=os.environ.get("AFS_JOURNAL_DIR") or
                    (".migration/evidence/runs" if os.path.isdir(".migration") else None),
                    help="committed run journal folder; 'off' disables it")
    a = ap.parse_args(opts)

    name = slug(a.name or " ".join(cmd[:3]))
    ticket = slug(a.ticket, 80)
    folder = os.path.join(a.runs_dir, ticket)
    os.makedirs(folder, exist_ok=True)
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    log_path = os.path.join(folder, f"{stamp}-{name}.log")

    tree = tree_fingerprint()
    start = time.monotonic()
    with open(log_path, "wb") as log:
        try:
            # The command knows its ticket (afs-mutation writes the ticket's survivor list, ADR-0018).
            code = subprocess.call(cmd, stdout=log, stderr=subprocess.STDOUT, env={**os.environ, "AFS_TICKET": ticket})
        except FileNotFoundError:
            log.write(f"afs-run: command not found: {cmd[0]}\n".encode())
            code = 127
    seconds = round(time.monotonic() - start, 2)

    with open(log_path, "rb") as fh:
        raw = fh.read()
    lines = raw.decode("utf-8", errors="replace").splitlines()

    record = {
        "ts": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "ticket": ticket, "name": name, "command": shlex.join(cmd), "exit": code,
        "seconds": seconds, "log": log_path, "lines": len(lines), "bytes": len(raw),
    }
    if tree:
        record["tree"] = tree
    runs_file = os.path.join(folder, "runs.jsonl")
    failed_before = earlier_failure(runs_file, record["command"], tree) if code == 0 else None
    with open(runs_file, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(record) + "\n")
    flaky = record_flaky(ticket, failed_before, record) if failed_before else None

    parts = summarize(lines, a.highlights, a.tail, code != 0)
    if a.journal_dir and a.journal_dir != "off":
        journal(a.journal_dir, ticket, record, hashlib.sha256(raw).hexdigest(), parts, result_of(lines))

    status = "ok" if code == 0 else "FAILED"
    print(f"afs-run: {name} {status} exit={code} {seconds}s · {len(lines)} lines, {len(raw)} bytes")
    print(f"log: {log_path}")
    for part in parts:
        print(part)
    if failed_before:
        where = f"; recorded in {flaky[0]}" if flaky else ""
        print(f"AFS-FLAKY command={name} failed_at={failed_before['ts']} tests={','.join(flaky[1]) if flaky else ''}"
              f" — this passed on the same code that failed before{where}. Don't rerun to make it pass: commit "
              "the record and say so in your return.")
    return code


if __name__ == "__main__":
    import afs_trace
    afs_trace.run(main)
