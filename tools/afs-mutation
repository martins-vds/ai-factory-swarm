#!/usr/bin/env python3
"""afs-mutation — the mutation gate: run mutmut on the changed (or given) code and enforce the score.

Usage (run it through afs-run so the run lands in the journal):
  afs-mutation [--changed-since REF | --all | --paths P1,P2] [--threshold X] [--src src]
               [--exclude GLOB ...] [--profile .migration/profile.yaml]

* Paths: Python files changed since REF (default $AFS_BASE or origin/main, then main), under --src,
  minus excludes (migrations, settings, wsgi/asgi, tests, __init__ files with no code). --all mutates
  the whole --src tree; --paths takes an explicit comma list.
* Only the files themselves are mutated (never whole packages). Each mutant runs a **narrowed test
  command**, fail-fast, without coverage collection or the pytest cache. --tests picks the tests:
  - `coverage` (default): one coverage run with per-test contexts finds, for each mutated file, the
    tests that execute it; each file's mutants run only those tests. Falls back to `auto` if
    pytest-cov is missing or the coverage run fails.
  - `auto`: the tests of the file's bounded context (`tests/<context>/` for `src/<pkg>/<context>/…`,
    else the whole suite).
  - `all`: the whole suite. --runner overrides all of these.
* **Parallel:** --jobs N (default: CPUs, max 4) shards the files across N copies of the working tree,
  each with its own mutmut cache. Each worker gets AFS_MUTATION_WORKER=<i>, and POSTGRES_DB is suffixed
  `_w<i>` so database tests don't share a test database. POSTGRES_DB comes from the environment, else from
  the profile's `services.env`; with test services declared but no POSTGRES_DB known, the run uses one
  worker rather than letting workers share a database.
* **No silent loss:** if `mutmut run` fails fatally on any file (exit bit 1, e.g. the tests fail before
  mutating), afs-mutation reports those files and exits 2 without a score; their mutants are never just
  left out of the denominator.
* Then `mutmut junitxml` per shard; score = killed / (killed + survived + untested). Untested mutants
  count as survived.
* Threshold: --threshold, else profile.thresholds.mutation_score_min, else 0.8.
* Exit 0 when score >= threshold or there is no changed code to mutate; 1 below the threshold; 2 on
  a usage or tool error. Prints one summary line and the surviving mutants' locations.
* Survivors are evidence (ADR-0018): run for a ticket (`AFS_TICKET`, which `afs-run` sets) in a repo with
  `.migration/`, it also writes **every** surviving mutant to `.migration/evidence/mutants/<ticket>.md`
  (overwritten each run), so the next session or a handoff can act on them without re-running the gate.
"""
import argparse
import fnmatch
import os
import pathlib
import re
import shutil
import subprocess
import sys
import concurrent.futures
import tempfile
import xml.etree.ElementTree as ET

DEFAULT_EXCLUDE = ["*/migrations/*", "*/settings.py", "*/settings/*", "*/wsgi.py", "*/asgi.py",
                   "*/tests/*", "*/test_*.py", "*_test.py", "*/conftest.py"]


def changed_files(since, src):
    for ref in ([since] if since else []) + [os.environ.get("AFS_BASE", ""), "origin/main", "main"]:
        if not ref:
            continue
        r = subprocess.run(["git", "diff", "--name-only", "--diff-filter=AM", f"{ref}...HEAD", "--", src],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return ref, [p for p in r.stdout.split() if p.endswith(".py")]
    raise SystemExit("afs-mutation: no base ref found (tried --changed-since, $AFS_BASE, origin/main, main)")


def keep(path, excludes):
    p = "/" + path.replace(os.sep, "/")
    if any(fnmatch.fnmatch(p, pat) or fnmatch.fnmatch(path, pat) for pat in excludes):
        return False
    if path.endswith("__init__.py"):
        text = pathlib.Path(path).read_text(encoding="utf-8", errors="ignore") if os.path.exists(path) else ""
        return bool(re.search(r"^\s*(def|class|if|for|while|return)\b", text, re.M))
    return True


def score_from_junit(xml_text):
    """killed, survived, skipped from `mutmut junitxml` output (failure/error = survived)."""
    root = ET.fromstring(xml_text)
    cases = root.iter("testcase")
    killed = survived = skipped = 0
    locations = []
    for case in cases:
        if case.find("skipped") is not None:
            skipped += 1
        elif case.find("failure") is not None or case.find("error") is not None:
            survived += 1
            locations.append(f"{case.get('file') or case.get('classname') or '?'}:{case.get('line') or '?'} "
                             f"{case.get('name') or ''}".strip())
        else:
            killed += 1
    return killed, survived, skipped, locations


COPY_IGNORE = shutil.ignore_patterns(".git", ".mutmut-cache", "__pycache__", ".pytest_cache", "node_modules",
                                     ".venv", "venv", ".source", ".migration", "*.lcov", ".coverage*")


def context_tests(path, src, tests_root="tests"):
    """tests/<context>/ for src/<pkg>/<context>/..., if it exists."""
    parts = pathlib.PurePath(path).parts
    srcparts = pathlib.PurePath(src).parts
    rest = parts[len(srcparts):] if parts[:len(srcparts)] == srcparts else parts
    if len(rest) >= 3:
        cand = pathlib.Path(tests_root, rest[1])
        if cand.is_dir():
            return str(cand)
    return None


def runner_for(paths, src, mode):
    cmd = [sys.executable, "-m", "pytest", "-q", "-x", "-p", "no:cacheprovider"]
    if subprocess.run([sys.executable, "-c", "import pytest_cov"], capture_output=True).returncode == 0:
        cmd.append("--no-cov")
    if mode == "auto":
        targets = {context_tests(p, src) for p in paths}
        if None not in targets:
            cmd += sorted(targets)
    return " ".join(cmd)


def has_pytest_cov():
    return subprocess.run([sys.executable, "-c", "import pytest_cov, coverage"], capture_output=True).returncode == 0


def base_cmd():
    cmd = [sys.executable, "-m", "pytest", "-q", "-x", "-p", "no:cacheprovider"]
    if has_pytest_cov():
        cmd.append("--no-cov")
    return cmd


def covering_tests(paths, src, test_targets):
    """Map each mutated file to the test node ids that execute it, from one per-test coverage run."""
    tmp = tempfile.mkdtemp(prefix="afs-cov-")
    env = dict(os.environ, COVERAGE_FILE=os.path.join(tmp, ".coverage"))
    cmd = [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider", "-o", "addopts=",
           f"--cov={src}", "--cov-context=test", "--cov-report="] + test_targets
    run = subprocess.run(cmd, env=env, capture_output=True, text=True)
    if run.returncode not in (0, 1) or not os.path.exists(env["COVERAGE_FILE"]):
        return None
    import coverage
    data = coverage.CoverageData(basename=env["COVERAGE_FILE"])
    data.read()
    measured = {os.path.realpath(f): f for f in data.measured_files()}
    out = {}
    for p in paths:
        f = measured.get(os.path.realpath(p))
        tests = set()
        if f:
            for ctxs in data.contexts_by_lineno(f).values():
                tests |= {c.split("|")[0] for c in ctxs if c}
        out[p] = sorted(t for t in tests if t)
    shutil.rmtree(tmp, ignore_errors=True)
    return out


def runners_for(paths, src, mode):
    """One test command per mutated file."""
    fallback = runner_for(paths, src, "auto" if mode == "coverage" else mode)
    if mode != "coverage" or not has_pytest_cov():
        return {p: fallback for p in paths}, mode if mode != "coverage" else "auto"
    targets = sorted({t for t in (context_tests(p, src) for p in paths) if t}) or []
    mapping = covering_tests(paths, src, targets)
    if mapping is None:
        return {p: fallback for p in paths}, "auto (coverage run failed)"
    runners = {}
    for p, tests in mapping.items():
        if not tests:
            runners[p] = fallback          # nothing executes this file: its mutants will survive honestly
            continue
        ids = tests if len(tests) <= 150 else sorted({t.split("::")[0] for t in tests})
        runners[p] = " ".join(base_cmd() + [f"'{t}'" for t in ids])
    return runners, "coverage"


def shards(paths, n):
    """Balance files across n shards by size (largest first)."""
    out = [[] for _ in range(max(1, min(n, len(paths))))]
    loads = [0] * len(out)
    for p in sorted(paths, key=lambda f: -os.path.getsize(f) if os.path.exists(f) else 0):
        i = loads.index(min(loads))
        out[i].append(p)
        loads[i] += os.path.getsize(p) if os.path.exists(p) else 1
    return [s for s in out if s]


MUTMUT_FATAL = 1   # mutmut 2.x exit codes are bit flags: 1 fatal, 2 survived, 4 timeout, 8 suspicious


def run_shard(i, workdir, paths, runners, env):
    """Run each file's mutants; return (junit xml or None, tail text, [(file, tail) that failed fatally])."""
    env = dict(env, AFS_MUTATION_WORKER=str(i))
    if env.get("POSTGRES_DB"):
        env["POSTGRES_DB"] = f"{env['POSTGRES_DB']}_w{i}"
    cache = os.path.join(workdir, ".mutmut-cache")
    if os.path.exists(cache):
        os.remove(cache)
    run, failed = None, []
    for p in paths:                         # one mutmut run per file, with that file's own tests
        run = subprocess.run(["mutmut", "run", "--paths-to-mutate", p, "--runner", runners[p]],
                             cwd=workdir, env=env, capture_output=True, text=True)
        # Survivors, timeouts and slow mutants set other bits; the score decides those. A fatal error means
        # this file's mutants were never tested, so it must not just vanish from the score.
        if run.returncode & MUTMUT_FATAL:
            failed.append((p, "\n".join((run.stdout + run.stderr).strip().splitlines()[-5:])))
    xml = subprocess.run(["mutmut", "junitxml", "--untested-policy", "failure", "--suspicious-policy", "ignore"],
                         cwd=workdir, env=env, capture_output=True, text=True)
    tail = (run.stdout + run.stderr).strip().splitlines()[-3:] if run else []
    return xml.stdout if "<testsuite" in xml.stdout else None, "\n".join(tail) + xml.stderr[-300:], failed


def services_env(profile):
    """Defaults from the profile's `services.env` (ADR-0016); the real environment wins."""
    try:
        import yaml
        prof = yaml.safe_load(pathlib.Path(profile).read_text(encoding="utf-8")) or {}
    except Exception:
        return {}, False
    services = prof.get("services") or {}
    return {k: str(v) for k, v in (services.get("env") or {}).items()}, bool(services)


def threshold_from(args):
    if args.threshold is not None:
        return args.threshold
    try:
        import yaml
        prof = yaml.safe_load(pathlib.Path(args.profile).read_text(encoding="utf-8"))
        return float(prof["thresholds"]["mutation_score_min"])
    except Exception:
        return 0.8


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--changed-since", default=None)
    g.add_argument("--all", action="store_true")
    g.add_argument("--paths")
    ap.add_argument("--threshold", type=float)
    ap.add_argument("--src", default="src")
    ap.add_argument("--exclude", action="append", default=[])
    ap.add_argument("--profile", default=".migration/profile.yaml")
    ap.add_argument("--jobs", type=int, default=min(4, os.cpu_count() or 1))
    ap.add_argument("--tests", choices=["coverage", "auto", "all"], default="coverage")
    ap.add_argument("--runner", help="test command for each mutant (default: narrowed pytest)")
    a = ap.parse_args()
    excludes = DEFAULT_EXCLUDE + a.exclude
    threshold = threshold_from(a)

    if a.paths:
        base, paths = "explicit", [p for p in a.paths.split(",") if p]
    elif a.all:
        base = "all"
        paths = [str(p) for p in pathlib.Path(a.src).rglob("*.py")]
    else:
        base, paths = changed_files(a.changed_since, a.src)
    paths = sorted(p for p in paths if keep(p, excludes))
    if not paths:
        print(f"afs-mutation: no mutable code changed ({base}); nothing to do")
        print(f"AFS-RESULT gate=mutation score=n/a reason=no-mutable-code-changed base={base}")
        return 0

    if shutil.which("mutmut") is None:
        print("afs-mutation: mutmut is not installed", file=sys.stderr)
        return 2
    out = subprocess.run(["mutmut", "version"], capture_output=True, text=True).stdout.strip()
    m = re.search(r"(\d+)\.\d+", out)          # e.g. "mutmut version 2.5.1"
    version = m.group(0) if m else out
    if m and m.group(1) != "2":
        print(f"afs-mutation: mutmut {version} not supported (needs 2.x)", file=sys.stderr)
        return 2
    if a.runner:
        runners, selection = {p: a.runner for p in paths}, "--runner"
    else:
        runners, selection = runners_for(paths, a.src, a.tests)
    defaults, has_services = services_env(a.profile)
    env = {**defaults, **os.environ}
    jobs = a.jobs
    if jobs > 1 and has_services and not env.get("POSTGRES_DB"):
        print("afs-mutation: test services are declared but POSTGRES_DB is unknown (set it, or services.env "
              "in the profile); running one worker so workers don't share a test database", file=sys.stderr)
        jobs = 1
    groups = shards(paths, jobs)
    results = []
    if len(groups) == 1:
        results.append(run_shard(0, ".", groups[0], runners, env))
    else:
        tmp = tempfile.mkdtemp(prefix="afs-mutation-")
        dirs = []
        for i in range(len(groups)):
            d = os.path.join(tmp, f"w{i}")
            shutil.copytree(".", d, ignore=COPY_IGNORE, symlinks=True)
            dirs.append(d)
        with concurrent.futures.ThreadPoolExecutor(len(groups)) as pool:
            results = list(pool.map(lambda t: run_shard(t[0], t[1], t[2], runners, env),
                                    [(i, dirs[i], groups[i]) for i in range(len(groups))]))
        shutil.rmtree(tmp, ignore_errors=True)
    killed = survived = skipped = 0
    locations = []
    failed = [f for _, _, fs in results for f in fs]
    if failed:
        for path, tail in failed:
            print(f"afs-mutation: mutmut failed on {path}; its mutants were not tested:\n{tail}", file=sys.stderr)
        print(f"AFS-RESULT gate=mutation score=n/a error=mutmut-failed failed_files={len(failed)} "
              f"files={len(paths)} base={base}")
        return 2
    for xml_text, tail, _ in results:
        if xml_text is None:
            print("afs-mutation: mutmut produced no results:\n" + tail, file=sys.stderr)
            return 2
        k, s_, sk, locs = score_from_junit(xml_text)
        killed, survived, skipped = killed + k, survived + s_, skipped + sk
        locations += locs
    total = killed + survived
    score = killed / total if total else 1.0
    ok = score >= threshold
    print(f"afs-mutation: {'ok' if ok else 'FAILED'} score={score:.3f} threshold={threshold} "
          f"killed={killed} survived={survived} skipped={skipped} files={len(paths)} jobs={len(groups)} base={base}")
    # The harness result line (ADR-0017): afs-run journals it; validate.py checks return files against it.
    print(f"AFS-RESULT gate=mutation score={score:.3f} threshold={threshold} killed={killed} survived={survived} "
          f"files={len(paths)} base={base}")
    print(f"  tests: {selection}; runner for {paths[0]}: {runners[paths[0]][:300]}")
    for loc in locations[:30]:
        print(f"  survived: {loc}")
    write_survivors(locations, score, threshold, killed, survived, base)
    return 0 if ok else 1


def write_survivors(locations, score, threshold, killed, survived, base):
    """Commit-ready list of every surviving mutant for the ticket (the raw log is not committed)."""
    ticket = os.environ.get("AFS_TICKET", "")
    if not ticket or ticket == "adhoc" or not os.path.isdir(".migration"):
        return None
    folder = pathlib.Path(".migration/evidence/mutants")
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"{re.sub(r'[^A-Za-z0-9._-]', '-', ticket)}.md"
    lines = [f"# Surviving mutants: {ticket}", "",
             f"Written by `afs-mutation` on its last run (base `{base}`): score {score:.3f}, threshold {threshold}, "
             f"killed {killed}, survived {survived}. Each line is a mutant no test killed: add a test that fails "
             "on it, or simplify the code if it is equivalent.", ""]
    lines += [f"- `{loc}`" for loc in locations] or ["- none"]
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path


if __name__ == "__main__":
    import afs_trace
    afs_trace.run(main)
