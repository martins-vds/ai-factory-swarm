#!/usr/bin/env python3
"""Merge agent PRs only the safe way (ADR-0047; amends ADR-0038 and ADR-0040).

  afs-merge work     --repo OWNER/NAME --pr N [--dry-run]
  afs-merge verifier --repo OWNER/NAME --pr N [--dry-run]     (run in a clone whose `origin` it may push to)

The operator decides that a PR merges; this tool decides how, and refuses the ways that went wrong:

* **work** merges a work PR into the default branch through the merge API. It refuses when:
  - the PR is a draft, closed, or targets another branch (a stacked PR: merge the one below it first);
  - another open PR is stacked on it (merge or close that first; merging the bottom of a stack while PRs
    sit on it left them on a moved base, synthetic #123);
  - any check on its head hasn't finished green, or a workflow run waits for approval (the operator
    approves runs; this tool never does);
  - the verified-merge check (`check_verified_merge.py`, ADR-0040/0045) isn't green.
  It never calls `merge-async`: that endpoint merged a stacked PR before its stack was verified.
* **verifier** merges an audit Verifier's PR into the work branch it targets, with `git merge --no-ff`, so
  the Verifier's tests and return join the work PR's history. It refuses when the PR targets the default
  branch, or the branch it targets isn't an open PR's head.

Exit 0 merged (or would merge, with --dry-run), 1 refused (the reason is printed), 2 usage or API error.
Standard library plus git and gh.
"""
import argparse
import json
import pathlib
import subprocess
import sys

VERIFIED = "Migrator work is verified before it merges"
GREEN = {"success", "skipped", "neutral"}


class Refused(Exception):
    pass


def api(path, method="GET", fields=None):
    args = ["gh", "api", "-X", method, path]
    for k, v in (fields or {}).items():
        args += ["-f", f"{k}={v}"]
    r = subprocess.run(args, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"gh api {method} {path}: {r.stderr.strip() or r.stdout.strip()}")
    return json.loads(r.stdout) if r.stdout.strip() else {}


def paged(path):
    out = subprocess.run(["gh", "api", "--paginate", path], capture_output=True, text=True, check=True).stdout
    return json.loads(out.replace("][", ",")) if out.strip() else []


def git(*args, check=True):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=check)


def checks_green(repo, sha):
    """Every check on `sha` finished green, no workflow run waits for approval, and the verified-merge
    check (when the harness CI runs it) is green."""
    runs = api(f"repos/{repo}/commits/{sha}/check-runs?per_page=100").get("check_runs", [])
    pending = [r["name"] for r in runs if r.get("status") != "completed"]
    if pending:
        raise Refused(f"checks still running: {', '.join(sorted(set(pending)))}")
    red = [f"{r['name']} ({r.get('conclusion')})" for r in runs if r.get("conclusion") not in GREEN]
    if red:
        raise Refused(f"checks not green: {', '.join(sorted(set(red)))}")
    latest = {}
    for w in sorted(api(f"repos/{repo}/actions/runs?head_sha={sha}&per_page=100").get("workflow_runs", []),
                    key=lambda w: w["id"]):
        latest[w["name"]] = w          # a workflow's latest run on this head decides
    waiting = [n for n, w in latest.items() if w.get("conclusion") == "action_required"]
    if waiting:
        raise Refused(f"workflow runs wait for the operator's approval: {', '.join(sorted(set(waiting)))}")
    if not runs:
        raise Refused("no checks have run on its head; approve its workflow runs first")
    verified = [r for r in runs if r["name"] == VERIFIED]
    if verified and not all(r.get("conclusion") == "success" for r in verified):
        raise Refused(f"'{VERIFIED}' isn't green")


def stacked_on(repo, head_ref, number):
    return [p["number"] for p in paged(f"repos/{repo}/pulls?state=open&per_page=100")
            if p["base"]["ref"] == head_ref and p["number"] != number]


def merge_work(repo, number, dry_run=False):
    pr = api(f"repos/{repo}/pulls/{number}")
    default = api(f"repos/{repo}")["default_branch"]
    if pr.get("state") != "open":
        raise Refused(f"#{number} is {pr.get('state')}")
    if pr.get("draft"):
        raise Refused(f"#{number} is a draft; mark it ready for review first")
    if pr["base"]["ref"] != default:
        raise Refused(f"#{number} targets `{pr['base']['ref']}`, not `{default}`: it is stacked. Merge the PR "
                      f"below it first; GitHub then retargets this one")
    above = stacked_on(repo, pr["head"]["ref"], number)
    if above:
        raise Refused(f"open PRs are stacked on #{number}: {', '.join(f'#{n}' for n in above)}. Merge "
                      f"(`afs-merge verifier`) or close them first")
    checks_green(repo, pr["head"]["sha"])
    if dry_run:
        return f"#{number} would merge into `{default}`"
    api(f"repos/{repo}/pulls/{number}/merge", "PUT", {"merge_method": "merge", "sha": pr["head"]["sha"]})
    return f"#{number} merged into `{default}`"


def merge_verifier(repo, number, dry_run=False):
    pr = api(f"repos/{repo}/pulls/{number}")
    default = api(f"repos/{repo}")["default_branch"]
    base, head = pr["base"]["ref"], pr["head"]["ref"]
    if pr.get("state") != "open":
        raise Refused(f"#{number} is {pr.get('state')}")
    if base == default:
        raise Refused(f"#{number} targets `{default}`: a Verifier PR merges into the work branch it verifies")
    work = [p for p in paged(f"repos/{repo}/pulls?state=open&per_page=100") if p["head"]["ref"] == base]
    if not work:
        raise Refused(f"`{base}` isn't the head of an open work PR")
    checks_green(repo, pr["head"]["sha"])
    if dry_run:
        return f"#{number} would merge into `{base}` (work PR #{work[0]['number']}) with --no-ff"
    git("fetch", "--quiet", "origin", f"+refs/heads/{base}:refs/remotes/origin/{base}",
        f"+refs/heads/{head}:refs/remotes/origin/{head}")
    git("checkout", "--quiet", "-B", base, f"origin/{base}")
    r = git("merge", "--no-ff", "--quiet", f"origin/{head}", "-m",
            f"Merge Verifier PR #{number} into {base} (afs-merge, ADR-0047)", check=False)
    if r.returncode != 0:
        git("merge", "--abort", check=False)
        raise Refused(f"merging `{head}` into `{base}` conflicts; resolve it in the Verifier's branch")
    git("push", "--quiet", "origin", f"HEAD:refs/heads/{base}")
    return f"#{number} merged into `{base}` (work PR #{work[0]['number']})"


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("kind", choices=["work", "verifier"])
    ap.add_argument("--repo", required=True)
    ap.add_argument("--pr", type=int, required=True)
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args(argv)
    try:
        print((merge_work if a.kind == "work" else merge_verifier)(a.repo, a.pr, a.dry_run))
        return 0
    except Refused as e:
        print(f"afs-merge: refused: {e}")
        return 1
    except (RuntimeError, subprocess.CalledProcessError, KeyError) as e:
        print(f"afs-merge: error: {getattr(e, 'stderr', '') or e}")
        return 2


if __name__ == "__main__":
    sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
    import afs_trace
    afs_trace.run(main)
