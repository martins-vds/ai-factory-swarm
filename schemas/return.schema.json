{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martins-vds/ai-factory-swarm/schemas/return.schema.json",
  "title": "AI Factory Swarm agent return file",
  "description": "Generated by tools/gen_return_schema.py from agents/*.agent.md \u2014 do not edit. `.migration/returns/<ticket>.<role>.yaml`: an agent's committed report for one ticket.",
  "type": "object",
  "required": [
    "role",
    "ticket",
    "issue"
  ],
  "properties": {
    "role": {
      "enum": [
        "afs-analyst",
        "afs-auditor",
        "afs-bootstrapper",
        "afs-characterizer",
        "afs-migrator",
        "afs-planner",
        "afs-program-orchestrator",
        "afs-slice-coordinator",
        "afs-specialist-migrator",
        "afs-verifier"
      ]
    },
    "ticket": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "issue": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$"
    },
    "gates": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "null"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-analyst"
          }
        }
      },
      "then": {
        "required": [
          "graphs",
          "ledger",
          "risk_map",
          "quirk_tickets",
          "graph_discrepancies"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-auditor"
          }
        }
      },
      "then": {
        "required": [
          "scope",
          "report",
          "capabilities_checked",
          "gaps",
          "graph_inconsistencies",
          "verdict"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-bootstrapper"
          }
        }
      },
      "then": {
        "required": [
          "setup_pr",
          "characterization_tier",
          "tier_evidence",
          "capabilities",
          "gap_tickets",
          "validation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-characterizer"
          }
        }
      },
      "then": {
        "required": [
          "tier_used",
          "suite",
          "predicted_vs_observed",
          "ledger_updated",
          "quirk_tickets",
          "review_only_requests"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-migrator"
          }
        }
      },
      "then": {
        "required": [
          "ticket",
          "pr",
          "gates",
          "evidence_logs",
          "ledger_updated",
          "quirk_tickets",
          "new_tickets",
          "handoff"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-planner"
          }
        }
      },
      "then": {
        "required": [
          "plan",
          "slices",
          "design_tickets",
          "data_slices",
          "unmapped_capabilities",
          "open_questions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-program-orchestrator"
          }
        }
      },
      "then": {
        "required": [
          "phase",
          "decisions",
          "dispatched",
          "awaiting_human",
          "next_step"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-slice-coordinator"
          }
        }
      },
      "then": {
        "required": [
          "slice",
          "tickets",
          "acceptance",
          "human_check",
          "human_check_issues",
          "quirk_tickets"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-specialist-migrator"
          }
        }
      },
      "then": {
        "required": [
          "ticket",
          "specialty",
          "pr",
          "gates",
          "specialty_evidence",
          "ledger_updated",
          "quirk_tickets",
          "handoff"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "afs-verifier"
          }
        }
      },
      "then": {
        "required": [
          "pr",
          "verdict",
          "gates",
          "evidence_logs",
          "findings",
          "tests_added",
          "ledger_issues",
          "quirk_tickets"
        ]
      }
    }
  ]
}
